---
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import '../styles/global.css'

interface Props {
	title?: string
	description?: string
}

const {
	title = 'Tamerlan Baimurat — Electrical engineering & AI',
	description = 'Electrical engineer building trustworthy AI, speech systems, high-performance software, and digital hardware.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const socialImage = new URL('/og.png', Astro.site ?? Astro.url.origin)
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#fcfcfc" />
		<link rel="canonical" href={canonical} />
		<title>{title}</title>
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content="Tamerlan Baimurat — Building AI and systems that hold up." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={socialImage} />
		<script is:inline>
			(() => {
				let saved
				try {
					saved = localStorage.getItem('theme')
				} catch {
					// System preference still works when browser storage is unavailable.
				}
				const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
				const theme = saved === 'light' || saved === 'dark' ? saved : preferred
				document.documentElement.dataset.theme = theme
				document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#141414' : '#fcfcfc'
			})()
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<main id="main-content">
			<slot />
		</main>
		<SiteFooter />
		<script>
			const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
			const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
			let manualTheme = false
			try {
				const saved = localStorage.getItem('theme')
				manualTheme = saved === 'light' || saved === 'dark'
			} catch {
				// The toggle also works without persistent storage.
			}

			function applyTheme(theme: string) {
				document.documentElement.dataset.theme = theme
				const label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
				toggle?.setAttribute('aria-label', label)
				toggle?.setAttribute('title', label)
				document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#141414' : '#fcfcfc')
			}

			applyTheme(document.documentElement.dataset.theme ?? 'light')

			toggle?.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
				manualTheme = true
				applyTheme(next)
				try {
					localStorage.setItem('theme', next)
				} catch {
					// Keep the chosen theme for this page even if it cannot be saved.
				}
			})

			systemTheme.addEventListener('change', (event) => {
				if (!manualTheme) applyTheme(event.matches ? 'dark' : 'light')
			})
		</script>
	</body>
</html>
