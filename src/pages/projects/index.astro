---
import Layout from '../../layouts/Layout.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import { projects } from '../../data/projects'

const filters = [
	{ key: 'all', label: 'All work' },
	{ key: 'AI & research', label: 'AI & research' },
	{ key: 'Software & systems', label: 'Software & systems' },
	{ key: 'Hardware & DSP', label: 'Hardware & DSP' },
]
---

<Layout title="Projects — Tamerlan Baimurat" description="Selected projects in trustworthy AI, speech processing, production systems, RAG, computer vision, FPGA design, and hardware.">
	<header class="page-hero">
		<div class="page-shell">
			<div>
				<p class="eyebrow">Projects</p>
				<h1>Projects.</h1>
				<p class="lede">A selection of my work in AI, software, speech, and hardware.</p>
			</div>
		</div>
	</header>

	<section class="section">
		<div class="section-shell">
			<div class="filter-bar" role="group" aria-label="Filter projects">
				{filters.map((filter, index) => (
					<button class="filter-button" type="button" data-filter={filter.key} aria-pressed={index === 0 ? 'true' : 'false'}>
						{filter.label}
					</button>
				))}
			</div>
			<div class="project-list" data-project-grid>
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>

	<script>
		const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')]
		const cards = [...document.querySelectorAll<HTMLElement>('[data-tracks]')]
		const aliases: Record<string, string> = {
			ai: 'AI & research',
			software: 'Software & systems',
			hardware: 'Hardware & DSP',
		}

		function applyFilter(value: string) {
			const requested = aliases[value.toLowerCase()] ?? value
			const selected = buttons.some((button) => button.dataset.filter === requested) ? requested : 'all'
			buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === selected)))
			cards.forEach((card) => {
				card.hidden = selected !== 'all' && !card.dataset.tracks?.split('|').includes(selected)
			})
		}

		buttons.forEach((button) => button.addEventListener('click', () => {
			applyFilter(button.dataset.filter ?? 'all')
			const url = new URL(window.location.href)
			if (button.dataset.filter === 'all') url.searchParams.delete('track')
			else url.searchParams.set('track', (button.dataset.filter ?? '').split(' ')[0].toLowerCase())
			history.replaceState({}, '', url)
		}))

		const initial = new URLSearchParams(window.location.search).get('track')
		if (initial) applyFilter(initial)
	</script>
</Layout>

