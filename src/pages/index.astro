---
import Layout from '../layouts/Layout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { featuredProjects } from '../data/projects'
---

<Layout>
	<section class="home-intro page-shell" aria-labelledby="intro-title">
		<p class="eyebrow">Electrical engineering · Boston, MA</p>
		<h1 id="intro-title">Tamerlan Baimurat<span aria-hidden="true">.</span></h1>
		<p class="intro-summary">I’m an electrical engineering student at Boston University, working on AI, speech, and the systems around them.</p>
		<p class="intro-note">Currently researching <a href="/research">trustworthy AI for medical documentation</a>.</p>
		<a class="text-link" href="/about">A little more about me <span aria-hidden="true">↗</span></a>
	</section>

	<section class="selected-work section-shell" aria-labelledby="work-title">
		<header class="work-heading">
			<h2 id="work-title">Selected work</h2>
			<a class="text-link" href="/projects">All projects <span aria-hidden="true">↗</span></a>
		</header>
		<div class="project-list">
			{featuredProjects.map((project) => <ProjectCard project={project} />)}
		</div>
	</section>
</Layout>
