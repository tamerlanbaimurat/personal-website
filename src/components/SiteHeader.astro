---
const path = Astro.url.pathname
const navItems = [
	{ href: '/projects', label: 'Work', active: path.startsWith('/projects') || path === '/research' },
	{ href: '/about', label: 'About', active: path === '/about' },
]
---

<header class="site-header">
	<div class="nav-shell">
		<a class="wordmark" href="/" aria-label="Tamerlan Baimurat, home">TB<span aria-hidden="true">.</span></a>
		<div class="nav-actions">
			<nav aria-label="Primary navigation">
				{navItems.map((item) => (
					<a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
				))}
				<a href="/Tamerlan-Baimurat-Resume.pdf" download>Resume</a>
			</nav>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">
				<svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M20.9 13.2A9 9 0 0 1 10.8 3.1a9 9 0 1 0 10.1 10.1Z" />
				</svg>
				<svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
				</svg>
			</button>
		</div>
	</div>
</header>
