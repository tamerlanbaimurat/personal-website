---
const path = Astro.url.pathname
const navItems = [
	{ href: '/research', label: 'Research' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/experience', label: 'Experience' },
	{ href: '/press', label: 'Press' },
	{ href: '/about', label: 'About' },
]
---

<header class="site-header">
	<div class="nav-shell">
		<a class="wordmark" href="/" aria-label="Tamerlan Baimurat, home">
			<span class="mark" aria-hidden="true">TB</span>
			<span class="wordmark-text">Tamerlan Baimurat</span>
		</a>

		<nav aria-label="Primary navigation">
			{navItems.map((item) => (
				<a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))}
		</nav>

		<div class="nav-actions">
			<a class="resume-link" href="/Tamerlan-Baimurat-Resume.pdf" download>Resume</a>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
				<span aria-hidden="true">◐</span>
			</button>
			<button class="menu-toggle" type="button" data-menu-toggle aria-label="Open navigation" aria-expanded="false">
				<span></span><span></span>
			</button>
		</div>
	</div>
</header>

<script>
	const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
	const navigation = document.querySelector<HTMLElement>('.site-header nav')

	menuButton?.addEventListener('click', () => {
		const open = menuButton.getAttribute('aria-expanded') === 'true'
		menuButton.setAttribute('aria-expanded', String(!open))
		navigation?.classList.toggle('is-open', !open)
	})

	navigation?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			menuButton?.setAttribute('aria-expanded', 'false')
			navigation.classList.remove('is-open')
		})
	})
</script>
