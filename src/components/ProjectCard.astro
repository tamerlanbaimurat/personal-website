---
import type { Project } from '../data/projects'

interface Props {
	project: Project
}

const { project } = Astro.props
---

<article class="project-card" data-tracks={project.tracks.join('|')}>
	<a class="project-link" href={project.href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noreferrer' : undefined}>
		<div>
			<p class="eyebrow">{project.kicker}</p>
			<h3>{project.title}</h3>
			<p class="project-summary">{project.summary}</p>
		</div>
		<span class="project-arrow" aria-hidden="true">↗</span>
	</a>
</article>
